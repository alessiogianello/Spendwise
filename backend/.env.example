# Anthropic API key. If unset, the SDK also picks up ANTHROPIC_AUTH_TOKEN or an
# `ant auth login` profile automatically - see the anthropic-cli docs.
ANTHROPIC_API_KEY=

# Model used by the agent. Swappable to compare cost/quality in the eval suite
# (e.g. claude-sonnet-5 for a cheaper run).
CLAUDE_MODEL=claude-opus-5

# SQLite file, relative to backend/
DATABASE_URL=sqlite:///./spendwise.db

# Single demo user - this project has no auth layer.
DEMO_USER_ID=1
