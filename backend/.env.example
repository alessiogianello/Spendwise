# OpenRouter model id in vendor/model form, e.g. anthropic/claude-sonnet-5,
# openai/gpt-5.4-mini, google/gemini-3.8-flash, deepseek/deepseek-v3.2
# (full list: openrouter.ai/models).
LLM_MODEL=anthropic/claude-opus-5

# Get one at openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Reasoning depth for models that support it (low | medium | high). Leave unset
# for the model default; unsupported models ignore it.
# OPENROUTER_REASONING_EFFORT=medium

# SQLite file, relative to backend/
DATABASE_URL=sqlite:///./spendwise.db

# Single demo user - this project has no auth layer.
DEMO_USER_ID=1

# Hosted demo only: shared passphrase the client asks for once (sent as
# X-Demo-Password). Leave unset locally to keep the API open.
# DEMO_PASSWORD=
