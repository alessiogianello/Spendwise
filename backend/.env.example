# Which backend answers: "anthropic" (Claude, native API) or "openrouter"
# (any model on openrouter.ai through its OpenAI-compatible API).
LLM_PROVIDER=anthropic

# Model id. For anthropic: claude-opus-5, claude-sonnet-5, ...
# For openrouter: vendor/model, e.g. anthropic/claude-sonnet-5, openai/gpt-5.4-mini,
# google/gemini-3.8-flash, deepseek/deepseek-v3.2 (full list: openrouter.ai/models).
# CLAUDE_MODEL still works as an alias.
LLM_MODEL=claude-opus-5

# --- anthropic ---
# If unset, the SDK also picks up ANTHROPIC_AUTH_TOKEN or an `ant auth login`
# profile automatically - see the anthropic-cli docs.
ANTHROPIC_API_KEY=
# Optional: route Claude through OpenRouter's Anthropic-compatible endpoint
# instead (keeps thinking + prompt caching, Anthropic models only).
# ANTHROPIC_BASE_URL=https://openrouter.ai/api

# --- openrouter ---
OPENROUTER_API_KEY=
# Reasoning depth for models that support it (low | medium | high). Leave unset
# for the model default; unsupported models ignore it.
# OPENROUTER_REASONING_EFFORT=medium

# SQLite file, relative to backend/
DATABASE_URL=sqlite:///./spendwise.db

# Single demo user - this project has no auth layer.
DEMO_USER_ID=1
